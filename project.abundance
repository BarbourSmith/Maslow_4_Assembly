                    {
                      "atomType": "GitHubMolecule",
                      "x": 0.72,
                      "y": 0.5,
                      "uniqueID": "id-12913",
                      "name": "Wire_Between_Points",
                      "ioValues": [
                        {
                          "name": "Start Shape",
                          "ioValue": "__GEOMETRY_INPUT__"
                        },
                        {
                          "name": "End Shape",
                          "ioValue": "__GEOMETRY_INPUT__"
                        },
                        {
                          "name": "Stiffness",
