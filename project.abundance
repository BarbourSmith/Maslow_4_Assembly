                              "atomType": "Output",
                              "x": 1,
                              "y": 0.5,
                              "uniqueID": "id-2082",
                              "ioValues": [
                                {
                                  "name": "number or geometry",
                                  "ioValue": "__GEOMETRY_INPUT__"
                                }
                              ]
                            },
                            {
                              "atomType": "Input",
                              "x": 0.055,
                              "y": 0.3333,
                              "uniqueID": "id-2083",
