                                      "code": "/**\n * Maslow 4.1 encoder PCB outline, read from the Edge.Cuts layer of the encoder\n * board's KiCad file and placed in drive-train coordinates (mm): the motor axis\n * is at X = 86.21, Y = 0, and the AS5600 sits over the -Y belt roller.\n * KiCad (kx, ky) maps to X = 196.21 - ky, Y = 150 - kx, with the top copper\n * (F.Cu) facing +Z. Arcs are [end, midpoint]; other steps are straight lines.\n */\nconst START: number[] = [107.0227, 13.9766];\nconst PATH: any[] = [\n  [[95.1353, 16.8664], [100.9059, 14.7094]],\n  [[68.0164, 4.4854], [78.5656, 17.2695]],\n  [67.8212, 3.6128], [67.6338, 2.4253], [67.523, 1.2458], [67.486, 0.0595],\n  [67.523, -1.1268], [67.6338, -2.3062], [67.8212, -3.4938], [68.0868, -4.6812],\n  [68.4102, -5.7945], [68.8164, -6.9252], [69.2997, -8.0419], [69.8428, -9.1058],\n  [70.4399, -10.1151], [71.1025, -11.0917], [71.8457, -12.051], [72.6224, -12.933],\n  [73.4933, -13.8038], [74.3755, -14.5807], [75.3346, -15.3238], [76.3112, -15.9865],\n  [77.3206, -16.5836], [78.3845, -17.1267], [79.5013, -17.61], [80.6319, -18.0162],\n  [81.7451, -18.3395], [82.9326, -18.6052], [84.1202, -18.7926], [85.2996, -18.9034],\n  [86.4859, -18.9404], [87.6723, -18.9034], [88.8517, -18.7926], [90.0392, -18.6052],\n  [109.982, -15.0993], [110.482, -14.9874], [111.4267, -14.6803], [112.3449, -14.2482],\n  [113.1811, -13.7176], [113.585, -13.4048], [114.0843, -12.9427],\n  [[116.4517, -7.2617], [115.8362, -10.339]],\n  [116.4622, 9.9732],\n  [[112.4622, 13.9732], [115.2906, 12.8016]],\n  [111.229, 13.97],\n];\n\nfunction run(): Assembly {\n  let pen: any = replicad.draw(START);\n  for (const step of PATH) {\n    if (Array.isArray(step[0])) pen = pen.threePointsArcTo(step[0], step[1]);\n    else pen = pen.lineTo(step);\n  }\n  return new Assembly({ geometry: pen.close(), tags: [\"encoder pcb outline\"] });\n}\n",
                                      "compiledCode": "\"use strict\";\n/**\n * Maslow 4.1 encoder PCB outline, read from the Edge.Cuts layer of the encoder\n * board's KiCad file and placed in drive-train coordinates (mm): the motor axis\n * is at X = 86.21, Y = 0, and the AS5600 sits over the -Y belt roller.\n * KiCad (kx, ky) maps to X = 196.21 - ky, Y = 150 - kx, with the top copper\n * (F.Cu) facing +Z. Arcs are [end, midpoint]; other steps are straight lines.\n */\nconst START = [107.0227, 13.9766];\nconst PATH = [\n    [[95.1353, 16.8664], [100.9059, 14.7094]],\n    [[68.0164, 4.4854], [78.5656, 17.2695]],\n    [67.8212, 3.6128], [67.6338, 2.4253], [67.523, 1.2458], [67.486, 0.0595],\n    [67.523, -1.1268], [67.6338, -2.3062], [67.8212, -3.4938], [68.0868, -4.6812],\n    [68.4102, -5.7945], [68.8164, -6.9252], [69.2997, -8.0419], [69.8428, -9.1058],\n    [70.4399, -10.1151], [71.1025, -11.0917], [71.8457, -12.051], [72.6224, -12.933],\n    [73.4933, -13.8038], [74.3755, -14.5807], [75.3346, -15.3238], [76.3112, -15.9865],\n    [77.3206, -16.5836], [78.3845, -17.1267], [79.5013, -17.61], [80.6319, -18.0162],\n    [81.7451, -18.3395], [82.9326, -18.6052], [84.1202, -18.7926], [85.2996, -18.9034],\n    [86.4859, -18.9404], [87.6723, -18.9034], [88.8517, -18.7926], [90.0392, -18.6052],\n    [109.982, -15.0993], [110.482, -14.9874], [111.4267, -14.6803], [112.3449, -14.2482],\n    [113.1811, -13.7176], [113.585, -13.4048], [114.0843, -12.9427],\n    [[116.4517, -7.2617], [115.8362, -10.339]],\n    [116.4622, 9.9732],\n    [[112.4622, 13.9732], [115.2906, 12.8016]],\n    [111.229, 13.97],\n];\nfunction run() {\n    let pen = replicad.draw(START);\n    for (const step of PATH) {\n        if (Array.isArray(step[0]))\n            pen = pen.threePointsArcTo(step[0], step[1]);\n        else\n            pen = pen.lineTo(step);\n    }\n    return new Assembly({ geometry: pen.close(), tags: [\"encoder pcb outline\"] });\n}\n"
                                    },
