                              "ioValues": [
                                {
                                  "name": "startShape",
                                  "ioValue": "__GEOMETRY_INPUT__"
                                },
                                {
                                  "name": "endShape",
                                  "ioValue": "__GEOMETRY_INPUT__"
                                },
