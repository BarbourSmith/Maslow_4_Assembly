                            {
                              "atomType": "Code",
                              "x": 0.6,
                              "y": 0.5,
                              "uniqueID": "id-13325",
                              "ioValues": [
                                {
                                  "name": "startShape",
                                  "ioValue": "__GEOMETRY_INPUT__"
                                },
                                {
                                  "name": "endShape",
                                  "ioValue": "__GEOMETRY_INPUT__"
                                },
                                {
